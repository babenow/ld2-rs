[Desktop Entry]
Type=Application
Name=Likedimion
Comment=Текстовая онлайн-MMORPG — клиент ld2 (gpui)
Exec=ld2-gpui
Icon=likedimion
Terminal=false
Categories=Game;RolePlaying;
