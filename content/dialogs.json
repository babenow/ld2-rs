{
  "npcs": [
    {
      "id": "npc_elder",
      "root": "l_hello",
      "training": [
        {
          "skill": "sword",
          "points": 10,
          "gold": 100
        },
        {
          "skill": "bow",
          "points": 10,
          "gold": 100
        },
        {
          "skill": "fire",
          "points": 10,
          "gold": 100,
          "items": [
            {
              "def_id": "herb",
              "qty": 1
            }
          ]
        }
      ],
      "lines": [
        {
          "id": "l_hello",
          "text": "Как дела, {name}?",
          "replies": [
            {
              "id": "r_work",
              "text": "Какая работа есть?",
              "next": "l_errand"
            },
            {
              "id": "r_pack",
              "text": "Ты знаешь про целебные зелья?",
              "next": "l_pack"
            },
            {
              "id": "r_care",
              "text": "Мне опасно выходить в лес?",
              "next": "l_female"
            },
            {
              "id": "r_glory",
              "text": "Я уже настоящий воин?",
              "next": "l_veteran"
            },
            {
              "id": "r_shop",
              "text": "Покажи свои товары.",
              "action": "shop"
            },
            {
              "id": "r_train",
              "text": "Чему ты можешь научить?",
              "action": "train"
            },
            {
              "id": "r_bye",
              "text": "Пока.",
              "next": null
            }
          ]
        },
        {
          "id": "l_errand",
          "text": "Отнеси весть в Чёрный лес — волки одолели путников!",
          "quest": "q_wolf_hunt",
          "every_s": 1800,
          "replies": [
            {
              "id": "r_errand_bye",
              "text": "Хорошо, позже зайду.",
              "next": null
            }
          ]
        },
        {
          "id": "l_pack",
          "text": "Ты носишь целебное зелье — держи его наготове.",
          "when": {
            "item": {
              "def_id": "potion_heal",
              "qty": 1
            }
          },
          "replies": [
            {
              "id": "r_pack_bye",
              "text": "Понятно.",
              "next": null
            }
          ]
        },
        {
          "id": "l_female",
          "text": "Девушкам в лесу стоит быть осторожнее, {name}.",
          "when": {
            "gender": "female"
          },
          "replies": [
            {
              "id": "r_female_bye",
              "text": "Спасибо за совет.",
              "next": null
            }
          ]
        },
        {
          "id": "l_veteran",
          "text": "Ты стал настоящим воином, {name}!",
          "when": {
            "level": {
              "min": 5
            }
          },
          "replies": [
            {
              "id": "r_vet_bye",
              "text": "Спасибо!",
              "next": null
            }
          ]
        }
      ]
    },
    {
      "id": "npc_city_elder",
      "root": "l_hello",
      "lines": [
        {
          "id": "l_hello",
          "text": "Добро пожаловать в город, {name}! Три улицы дают приют всем ремёслам — и всем историям.",
          "replies": [
            {
              "id": "r_history",
              "text": "Как появился этот город?",
              "next": "l_hist_start"
            },
            {
              "id": "r_rats",
              "text": "Что за крысы на складе?",
              "next": "l_rats"
            },
            {
              "id": "r_crafts",
              "text": "Почему здесь так много ремёсел?",
              "next": "l_crafts"
            },
            {
              "id": "r_streets",
              "text": "Что где есть по улицам?",
              "next": "l_city"
            },
            {
              "id": "r_rumors",
              "text": "Расскажи свежий слух.",
              "next": "l_rumors"
            },
            {
              "id": "r_shop",
              "text": "Покажи свои товары.",
              "action": "shop"
            },
            {
              "id": "r_bye",
              "text": "Пока."
            }
          ]
        },
        {
          "id": "l_hist_start",
          "text": "Город вырос из рыночной площади. Сначала — три придорожных лотка, потом стены, потом — имя. Улицы назвали по солдатскому счёту: северная, центральная, южная.",
          "replies": [
            {
              "id": "r_hist_wars",
              "text": "А до того, как появились стены?",
              "next": "l_hist_wars"
            },
            {
              "id": "r_hist_name",
              "text": "Почему названия такие скучные?",
              "next": "l_hist_name"
            },
            {
              "id": "r_bye_l_hist_start",
              "text": "Пока."
            }
          ]
        },
        {
          "id": "l_hist_wars",
          "text": "До стен — северный набег. Сжгли амбары, а горожане отбились… кузнечным молотом и рогатинами. С той поры кузница у восточных ворот никогда не остывает.",
          "replies": [
            {
              "id": "r_hist_wall",
              "text": "Кто строил стены?",
              "next": "l_hist_wall"
            },
            {
              "id": "r_hist_mage",
              "text": "А магия? Говорят, была война и с волшебниками.",
              "next": "l_hist_mage"
            },
            {
              "id": "r_bye_l_hist_wars",
              "text": "Пока."
            }
          ]
        },
        {
          "id": "l_hist_wall",
          "text": "Плотники с юга — отцы нынешнего мастера. За три лета срубили башни; в знак того, что плотницкая мастерская стоит на северной улице до сих пор.",
          "replies": [
            {
              "id": "r_hist_wall_end",
              "text": "Ясно. Спасибо за рассказ."
            }
          ]
        },
        {
          "id": "l_hist_mage",
          "text": "Магов не было — были лже-знахари. Пока алхимик не выжег им лавку правдой: с тех пор лаборатория и репутация города — одним словом «честно».",
          "replies": [
            {
              "id": "r_hist_mage_end",
              "text": "Интересно."
            }
          ]
        },
        {
          "id": "l_hist_name",
          "text": "Солдатский счёт: северная, центральная, южная. Кто-то предлагал назвать в честь героев — но герои спорили, кому какая улица. Так и оставили порядок.",
          "replies": [
            {
              "id": "r_hist_name_end",
              "text": "Смешно."
            }
          ]
        },
        {
          "id": "l_rats",
          "text": "Склад держал припасы города, пока однажды с юга не завезли ящики… с незваными жильцами. Крысы расплодились за месяц, а в дальнем углу поселилось нечто крупное.",
          "replies": [
            {
              "id": "r_rats_giant",
              "text": "Огромная крыса? Это правда?",
              "next": "l_rats_giant"
            },
            {
              "id": "r_rats_how",
              "text": "Стоит того — туда сунуться?",
              "next": "l_rats_how"
            },
            {
              "id": "r_bye_l_rats",
              "text": "Пока."
            }
          ]
        },
        {
          "id": "l_rats_giant",
          "text": "Правда. Видел своими глазами — спина как у телятины, глаза как у крысы. Зовут её Огромной крысой. Осмелится — город щедро отблагодарит.",
          "replies": [
            {
              "id": "r_rats_giant_end",
              "text": "Я загляну."
            }
          ]
        },
        {
          "id": "l_rats_how",
          "text": "За хвосты и трофеи платят, да и само добыча неплоха: зелья, золото, травы. Только иди неспеша — она в дальнем углу и не любит гостей.",
          "replies": [
            {
              "id": "r_rats_how_end",
              "text": "Понятно."
            }
          ]
        },
        {
          "id": "l_crafts",
          "text": "Три мастера — три улицы: кузнец у центральной, плотник на северной, алхимик в лаборатории. Каждый — честь фамилии, каждый — с историей.",
          "replies": [
            {
              "id": "r_crafts_forge",
              "text": "Расскажи про кузницу.",
              "next": "l_crafts_forge"
            },
            {
              "id": "r_crafts_alchemy",
              "text": "А алхимик?",
              "next": "l_crafts_alchemy"
            },
            {
              "id": "r_bye_l_crafts",
              "text": "Пока."
            }
          ]
        },
        {
          "id": "l_crafts_forge",
          "text": "Наковальня звенит с той самой войны. Куют клинки для тех, кто идёт на север — и точат то, что привозят обратно. Ковки пока в городе не учат — только нраву учат.",
          "replies": [
            {
              "id": "r_crafts_forge_end",
              "text": "Смешно сказано."
            }
          ]
        },
        {
          "id": "l_crafts_alchemy",
          "text": "Алхимик варит зелья сам и торгует ими у себя в лаборатории. Траву собирают под городом — за южными воротами. Говорит, его настойки лечат даже от городских сплетен.",
          "replies": [
            {
              "id": "r_crafts_alchemy_end",
              "text": "Спасибо."
            }
          ]
        },
        {
          "id": "l_city",
          "text": "Северная — лавки и мастерские, южная — тихая, у самой стены; центральная держит торг и слухи. Кузница — на востоке центральной, склад — за южной.",
          "replies": [
            {
              "id": "r_city_end",
              "text": "Понятно."
            }
          ]
        },
        {
          "id": "l_rumors",
          "text": "Слышал? Ночью со склада снова крики — крысы что ли… или тот, кто с ними. Сходи сам, если веришь сплетням меньше, чем монетам.",
          "replies": [
            {
              "id": "r_rumors_end",
              "text": "Учту."
            }
          ],
          "every_s": 600
        }
      ]
    },
    {
      "id": "npc_weaponsmith",
      "root": "l_hello",
      "lines": [
        {
          "id": "l_hello",
          "text": "Клинки на любой вкус — от кинжала до двуручника.",
          "replies": [
            {
              "id": "r_shop",
              "text": "Покажи клинки.",
              "action": "shop"
            },
            {
              "id": "r_bye",
              "text": "Пока.",
              "next": null
            }
          ]
        }
      ]
    },
    {
      "id": "npc_armorer",
      "root": "l_hello",
      "lines": [
        {
          "id": "l_hello",
          "text": "Доспех держит удар — смотри, что по размеру.",
          "replies": [
            {
              "id": "r_shop",
              "text": "Покажи доспехи.",
              "action": "shop"
            },
            {
              "id": "r_bye",
              "text": "Пока.",
              "next": null
            }
          ]
        }
      ]
    },
    {
      "id": "npc_alchemist",
      "root": "l_hello",
      "lines": [
        {
          "id": "l_hello",
          "text": "Зелья свежей варки. Стол — вон тот, если надо сварить самому.",
          "replies": [
            {
              "id": "r_shop",
              "text": "Покажи зелья.",
              "action": "shop"
            },
            {
              "id": "r_bye",
              "text": "Пока.",
              "next": null
            }
          ]
        }
      ]
    }
  ]
}
