{
  "npcs": [
    {
      "id": "npc_elder",
      "root": "l_hello",
      "training": [
        {
          "skill": "sword",
          "points": 10,
          "gold": 100
        },
        {
          "skill": "bow",
          "points": 10,
          "gold": 100
        },
        {
          "skill": "fire",
          "points": 10,
          "gold": 100,
          "items": [
            {
              "def_id": "herb",
              "qty": 1
            }
          ]
        }
      ],
      "lines": [
        {
          "id": "l_hello",
          "text": "Как дела, {name}?",
          "replies": [
            {
              "id": "r_work",
              "text": "Какая работа есть?",
              "next": "l_errand"
            },
            {
              "id": "r_pack",
              "text": "Ты знаешь про целебные зелья?",
              "next": "l_pack"
            },
            {
              "id": "r_care",
              "text": "Мне опасно выходить в лес?",
              "next": "l_female"
            },
            {
              "id": "r_glory",
              "text": "Я уже настоящий воин?",
              "next": "l_veteran"
            },
            {
              "id": "r_shop",
              "text": "Покажи свои товары.",
              "action": "shop"
            },
            {
              "id": "r_train",
              "text": "Чему ты можешь научить?",
              "action": "train"
            },
            {
              "id": "r_bye",
              "text": "Пока.",
              "next": null
            }
          ]
        },
        {
          "id": "l_errand",
          "text": "Отнеси весть в Чёрный лес — волки одолели путников!",
          "quest": "q_wolf_hunt",
          "every_s": 1800,
          "replies": [
            {
              "id": "r_errand_bye",
              "text": "Хорошо, позже зайду.",
              "next": null
            }
          ]
        },
        {
          "id": "l_pack",
          "text": "Ты носишь целебное зелье — держи его наготове.",
          "when": {
            "item": {
              "def_id": "potion_heal",
              "qty": 1
            }
          },
          "replies": [
            {
              "id": "r_pack_bye",
              "text": "Понятно.",
              "next": null
            }
          ]
        },
        {
          "id": "l_female",
          "text": "Девушкам в лесу стоит быть осторожнее, {name}.",
          "when": {
            "gender": "female"
          },
          "replies": [
            {
              "id": "r_female_bye",
              "text": "Спасибо за совет.",
              "next": null
            }
          ]
        },
        {
          "id": "l_veteran",
          "text": "Ты стал настоящим воином, {name}!",
          "when": {
            "level": {
              "min": 5
            }
          },
          "replies": [
            {
              "id": "r_vet_bye",
              "text": "Спасибо!",
              "next": null
            }
          ]
        }
      ]
    },
    {
      "id": "npc_city_elder",
      "root": "l_hello",
      "lines": [
        {
          "id": "l_hello",
          "text": "Добро пожаловать в город, {name}! Три улицы дают приют всем ремёслам.",
          "replies": [
            {
              "id": "r_shop",
              "text": "Покажи свои товары.",
              "action": "shop"
            },
            {
              "id": "r_streets",
              "text": "Что где есть?",
              "next": "l_city"
            },
            {
              "id": "r_ware",
              "text": "Почему со склада крики?",
              "next": "l_ware"
            },
            {
              "id": "r_bye",
              "text": "Пока.",
              "next": null
            }
          ]
        },
        {
          "id": "l_city",
          "text": "Северная — лавки и мастерские, южная — тихая, у самой стены; центральная держит торг и слухи. Кузница — на востоке, алхимия — на северной.",
          "replies": [
            {
              "id": "r_city_back",
              "text": "Понятно.",
              "next": null
            }
          ]
        },
        {
          "id": "l_ware",
          "text": "Старый склад… крысы расплодились, а с величиной в дальнем углу не справиться и мне. Кто осмелится — заходи, город наградит.",
          "replies": [
            {
              "id": "r_ware_back",
              "text": "Я зайду.",
              "next": null
            }
          ]
        }
      ]
    },
    {
      "id": "npc_weaponsmith",
      "root": "l_hello",
      "lines": [
        {
          "id": "l_hello",
          "text": "Клинки на любой вкус — от кинжала до двуручника.",
          "replies": [
            {
              "id": "r_shop",
              "text": "Покажи клинки.",
              "action": "shop"
            },
            {
              "id": "r_bye",
              "text": "Пока.",
              "next": null
            }
          ]
        }
      ]
    },
    {
      "id": "npc_armorer",
      "root": "l_hello",
      "lines": [
        {
          "id": "l_hello",
          "text": "Доспех держит удар — смотри, что по размеру.",
          "replies": [
            {
              "id": "r_shop",
              "text": "Покажи доспехи.",
              "action": "shop"
            },
            {
              "id": "r_bye",
              "text": "Пока.",
              "next": null
            }
          ]
        }
      ]
    },
    {
      "id": "npc_alchemist",
      "root": "l_hello",
      "lines": [
        {
          "id": "l_hello",
          "text": "Зелья свежей варки. Стол — вон тот, если надо сварить самому.",
          "replies": [
            {
              "id": "r_shop",
              "text": "Покажи зелья.",
              "action": "shop"
            },
            {
              "id": "r_bye",
              "text": "Пока.",
              "next": null
            }
          ]
        }
      ]
    }
  ]
}
